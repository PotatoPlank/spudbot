{
    "name": "potatoplank/spudbot",
    "description": "A discord bot built on top of DiscordPHP",
    "authors": [
        {
            "name": "PotatoPlank",
            "email": "potatoplank@protonmail.com"
        }
    ],
    "require": {
        "team-reflex/discord-php": "^10.36",
        "nesbot/carbon": "^3.10",
        "doctrine/dbal": "^3.6",
        "vlucas/phpdotenv": "v5.6.2",
        "twig/twig": "^3.21",
        "sentry/sdk": "^3.5",
        "ext-pcntl": "*",
        "doctrine/migrations": "^3.6",
        "guzzlehttp/guzzle": "^7.10",
        "php-di/php-di": "^7.1",
        "fakerphp/faker": "^1.23",
        "illuminate/collections": "^10.48",
        "doctrine/inflector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spudbot\\": "src/Spudbot"
        }
    },
    "suggest": {
        "ext-uv": ""
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
      "platform": {
        "php": "8.3"
      }
    }
}
